{
  "version": 2,
  "harness": "antigravity",
  "skill": "antigravity-harness-handoff",
  "generated_by": "scripts/build_skills.py",
  "generated_from": "skills-src/contracts.json",
  "binary": "agy",
  "prompt_delivery": "argv_last",
  "prompt_file_flag": null,
  "parser": "json_object",
  "sdk": {
    "kind": "library",
    "status": "preview",
    "languages": [
      "python"
    ],
    "packages": {
      "python": "google-antigravity"
    },
    "entrypoints": {
      "python": "Agent"
    },
    "command": null,
    "repositories": {
      "python": "https://github.com/google-antigravity/antigravity-sdk-python"
    },
    "docs": "https://antigravity.google/docs/sdk/overview/",
    "runtimes": {
      "python": "python>=3.10"
    },
    "session": "agent-conversation",
    "ownership": "mixed",
    "surface": "local",
    "fresh": "sdk-or-cli",
    "continuation": "cli",
    "history": "sdk-or-cli",
    "history_scope": "either",
    "continuation_scope": "native-existing-only",
    "stream": "sdk-events",
    "id_namespaces": [
      "agy-conversation",
      "sdk-conversation"
    ],
    "forbidden_operations": [
      "sdk-takeover-of-native-conversation",
      "gemini-api-as-session-control",
      "newest-as-exact"
    ],
    "auth_channel": "api-key",
    "auth": "mixed",
    "auth_notes": "SDK-owned agents use GEMINI_API_KEY or enterprise ADC/provider configuration. An existing agy/IDE conversation remains native-session and is not addressable with an SDK-owned conversation ID.",
    "approval_notes": "Use SDK policies, hooks, and capability controls for SDK-owned agents. Use CLI approval and sandbox flags for CLI continuation. Permission approval is not proof that sandboxing is off.",
    "evidence": {
      "docs_checked": true,
      "registry_checked": true,
      "cli_present": true,
      "sdk_smoke_passed": false
    }
  },
  "model_from_route": false,
  "discovery_argv": [
    "models"
  ],
  "call_workdir": false,
  "task_config_strategy": "none",
  "oneshot_argv": [
    "--output-format",
    "json",
    "--print",
    "<prompt>"
  ],
  "interactivity": "prompts",
  "credential_channel": "native-session",
  "credential_auth": "native-session",
  "references": [
    "references/history-and-continuation.md",
    "references/operating-guide.md"
  ],
  "advisory_vocabulary": {
    "status": [
      "started",
      "milestone",
      "blocked",
      "done"
    ],
    "fan_out": [
      "blocked",
      "done"
    ],
    "semantics": "self-reported presence, never proof of completion; carries no control state and never blocks the lane",
    "implemented_by": "work-coordination"
  },
  "adapter": "harness_fleet/providers/antigravity.py"
}
