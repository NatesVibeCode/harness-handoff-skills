  "proof_spec": {
    "behavior": [
      {
        "id": "success",
        "source": "Literal and arithmetic expectations specified before execution. Invalid model changes only the selected model while holding prompt, permissions and workspace constant.",
        "inputs": {
          "prompt": "Reply with exactly SDK_QUALIFIED. Do not use tools.",
          "workspace": "/private/var/empty",
          "settings": {
            "model": {
              "providerID": "openrouter",
              "modelID": "openai/gpt-4.1-mini"
            },
            "permission": {
              "*": "deny"
            }
          }
        },
        "assertions": [
          {
            "field": "receipt",
            "path": "/output",
            "operator": "equals",
            "value": "SDK_QUALIFIED"
          },
          {
            "field": "receipt",
            "path": "/session_id",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "held_out",
        "source": "Literal and arithmetic expectations specified before execution. Invalid model changes only the selected model while holding prompt, permissions and workspace constant.",
        "inputs": {
          "prompt": "What is 19 multiplied by 23? Reply with only the integer. Do not use tools.",
          "workspace": "/private/var/empty",
          "settings": {
            "model": {
              "providerID": "openrouter",
              "modelID": "openai/gpt-4.1-mini"
            },
            "permission": {
              "*": "deny"
            }
          }
        },
        "assertions": [
          {
            "field": "receipt",
            "path": "/output",
            "operator": "equals",
            "value": "437"
          },
          {
            "field": "receipt",
            "path": "/session_id",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "invalid_model",
        "source": "Literal and arithmetic expectations specified before execution. Invalid model changes only the selected model while holding prompt, permissions and workspace constant.",
        "inputs": {
          "prompt": "Reply with exactly SDK_QUALIFIED. Do not use tools.",
          "workspace": "/private/var/empty",
          "settings": {
            "model": {
              "providerID": "openrouter",
              "modelID": "qualification/no-such-model-20261016"
            },
            "permission": {
              "*": "deny"
            }
          }
        },
        "error": "SDK operation failed: exit status 1"
      }
    ],
    "test": {
      "pointer": "sdkdispatch.TestSDKDispatchRequiresPrintedRuntime",
      "digest": "91893f105cbc8ca2fe9fddd7b2cfb0a8c2f47244879441b1a993307a3450e753"
    },
    "target": "sdk-runtime",
    "mode": "real_service"
  },
  "usage": {
    "purpose": "Invoke exactly one opencode Typescript SDK fresh operation through its pinned adapter and return a bound receipt.",
    "use_when": [
      "an explicit opencode SDK fresh operation is selected"
    ],
    "avoid_when": [
      "the selected SDK package version or exact session identity is unknown"
    ]
  }
