  "proof_spec": {
    "behavior": [
      {
        "id": "success",
        "source": "Literal and arithmetic expectations specified before execution. Invalid model changes only the selected model while holding prompt, permissions and workspace constant.",
        "inputs": {
          "prompt": "Reply with exactly SDK_QUALIFIED. Do not use tools.",
          "workspace": "/private/var/empty",
          "settings": {
            "model": "openai/gpt-4.1-mini",
            "permission": "deny_unapproved",
            "provider": {
              "type": "openai",
              "base_url": "https://openrouter.ai/api/v1",
              "api_key_env": "OPENROUTER_API_KEY",
              "wire_api": "completions"
            }
          }
        },
        "assertions": [
          {
            "field": "receipt",
            "path": "/output",
            "operator": "equals",
            "value": "SDK_QUALIFIED"
          },
          {
            "field": "receipt",
            "path": "/session_id",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "held_out",
        "source": "Literal and arithmetic expectations specified before execution. Invalid model changes only the selected model while holding prompt, permissions and workspace constant.",
        "inputs": {
          "prompt": "What is 19 multiplied by 23? Reply with only the integer. Do not use tools.",
          "workspace": "/private/var/empty",
          "settings": {
            "model": "openai/gpt-4.1-mini",
            "permission": "deny_unapproved",
            "provider": {
              "type": "openai",
              "base_url": "https://openrouter.ai/api/v1",
              "api_key_env": "OPENROUTER_API_KEY",
              "wire_api": "completions"
            }
          }
        },
        "assertions": [
          {
            "field": "receipt",
            "path": "/output",
            "operator": "equals",
            "value": "437"
          },
          {
            "field": "receipt",
            "path": "/session_id",
            "operator": "non_empty"
          }
        ]
      },
      {
        "id": "invalid_model",
        "source": "Literal and arithmetic expectations specified before execution. Invalid model changes only the selected model while holding prompt, permissions and workspace constant.",
        "inputs": {
          "prompt": "Reply with exactly SDK_QUALIFIED. Do not use tools.",
          "workspace": "/private/var/empty",
          "settings": {
            "model": "qualification-no-such-model-20261016",
            "permission": "deny_unapproved",
            "provider": {
              "type": "openai",
              "base_url": "https://openrouter.ai/api/v1",
              "api_key_env": "OPENROUTER_API_KEY",
              "wire_api": "completions"
            }
          }
        },
        "error": "SDK operation failed: exit status 1"
      }
    ],
